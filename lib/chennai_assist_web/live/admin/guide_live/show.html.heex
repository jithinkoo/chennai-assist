<.header>
  Guide {@guide.id}
  <:subtitle>This is a guide record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/admin/guides/#{@guide}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit guide</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Title">{@guide.title}</:item>
  <:item title="Slug">{@guide.slug}</:item>
  <:item title="Category">{@guide.category}</:item>
  <:item title="Summary">{@guide.summary}</:item>
  <:item title="Body">{@guide.body}</:item>
  <:item title="Published">{@guide.published}</:item>
</.list>

<.back navigate={~p"/admin/guides"}>Back to guides</.back>

<.modal :if={@live_action == :edit} id="guide-modal" show on_cancel={JS.patch(~p"/admin/guides/#{@guide}")}>
  <.live_component
    module={ChennaiAssistWeb.Admin.GuideLive.FormComponent}
    id={@guide.id}
    title={@page_title}
    action={@live_action}
    guide={@guide}
    patch={~p"/admin/guides/#{@guide}"}
  />
</.modal>
