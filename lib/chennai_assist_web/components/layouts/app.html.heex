<header class="bg-white/90 backdrop-blur border-b border-zinc-200 sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
    <.link navigate={~p"/"} class="flex items-center gap-2">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand text-white font-bold">
        CA
      </span>
      <span class="leading-tight">
        <span class="block font-bold text-zinc-900">Chennai Assist</span>
        <span class="block text-xs text-zinc-500">Your Chennai help desk</span>
      </span>
    </.link>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium">
      <.link navigate={~p"/guide"} class="hover:text-brand">City guide</.link>
      <.link navigate={~p"/ask"} class="hover:text-brand">Ask a question</.link>
      <.link navigate={~p"/photos"} class="hover:text-brand">Photos</.link>
      <.link navigate={~p"/interviews"} class="hover:text-brand">Interviews</.link>
      <.link
        navigate={~p"/chat"}
        class="rounded-full bg-brand px-3 py-1.5 text-white hover:bg-orange-800"
      >
        Live chat
      </.link>
    </nav>
  </div>
  <div :if={@current_user} class="bg-sea text-white text-xs">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-1.5 flex flex-wrap gap-x-4 gap-y-1 items-center">
      <span class="font-semibold">Admin</span>
      <.link navigate={~p"/admin"} class="hover:underline">Dashboard</.link>
      <.link navigate={~p"/admin/chats"} class="hover:underline">Chats</.link>
      <.link navigate={~p"/admin/questions"} class="hover:underline">Questions</.link>
      <.link navigate={~p"/admin/guides"} class="hover:underline">Guides</.link>
      <.link navigate={~p"/admin/photos"} class="hover:underline">Photos</.link>
      <.link navigate={~p"/admin/interviews"} class="hover:underline">Interviews</.link>
      <span class="ml-auto opacity-80">{@current_user.email}</span>
      <.link href={~p"/users/settings"} class="hover:underline">Settings</.link>
      <.link href={~p"/users/log_out"} method="delete" class="hover:underline">Log out</.link>
    </div>
  </div>
</header>
<main class="px-4 py-8 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
<footer class="border-t border-zinc-200 bg-white mt-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-6 text-sm text-zinc-500 flex flex-wrap gap-4 justify-between">
    <p>Chennai Assist: help for moving to, living in and visiting Chennai.</p>
    <p>
      <.link navigate={~p"/chat"} class="text-brand hover:underline">Chat with us</.link>
      · <.link navigate={~p"/ask"} class="text-brand hover:underline">Ask a question</.link>
      · <.link href={~p"/users/log_in"} class="hover:underline">Admin</.link>
    </p>
  </div>
</footer>
