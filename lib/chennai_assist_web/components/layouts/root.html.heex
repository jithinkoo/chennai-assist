<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Chennai Assist: a help desk and personal assistant for anyone moving to, living in or visiting Chennai."
    />
    <.live_title suffix=" · Chennai Assist">
      <%= assigns[:page_title] || "Your Chennai help desk" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-sand text-zinc-800 antialiased">
    <%= @inner_content %>
  </body>
</html>
